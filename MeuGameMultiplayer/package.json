{
  "name": "bornengine-multiplayer-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Local Colyseus multiplayer demo built with BornEngine",
  "scripts": {
    "build": "perry compile main.ts -o meugame-multiplayer",
    "start": "./meugame-multiplayer",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@bornengine/engine": "^0.6.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "@bornengine/engine/*"
      ]
    }
  }
}
